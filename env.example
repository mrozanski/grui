# Copy this file to .env.local and fill in your actual values

# Database Configuration
# Replace with your actual PostgreSQL connection details
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# EAS Configuration
# Network: sepolia (testnet) or mainnet
NETWORK=sepolia

# Base RPC URL (use Alchemy, Infura, or QuickNode for better reliability)
# 
# Base Sepolia:
#   - Recommended: https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
#   - Alternative: https://sepolia.base.org (public, may have rate limits)
# 
# Base Mainnet:
#   - Recommended: https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
#   - Alternative: https://mainnet.base.org (public, may have rate limits)
# 
# Ethereum Sepolia:
#   - Recommended: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   - Alternative: https://sepolia.infura.io/v3/YOUR_KEY
#   - Alternative: https://rpc.ankr.com/eth_sepolia/YOUR_API_KEY (requires free API key from https://www.ankr.com/rpc/)
# 
BASE_RPC_URL=https://sepolia.base.org

# Admin Wallet (for schema registration and attestation signing)
# ⚠️  WARNING: Keep your private key secure! Never commit to git.
ADMIN_PRIVATE_KEY=0x...
ADMIN_WALLET_ADDRESS=0x...

# EAS Contract Addresses (auto-selected based on NETWORK, but can override)
# Base Sepolia Schema Registry: 0x0a7E2Ff54e76B8E6659aedC9103FB21c038050D0
# Base Mainnet Schema Registry: 0x4200000000000000000000000000000000000020
# SCHEMA_REGISTRY_ADDRESS=0x...

# Schema UIDs (populated after running register-eas-schemas script)
# VERSION_METADATA_SCHEMA_UID=0x...
# MODEL_SCHEMA_UID=0x...
# MODEL_SCHEMA_VERSION=1.0.0
# INSTRUMENT_SCHEMA_UID=0x...
# INSTRUMENT_SCHEMA_VERSION=1.0.0

# EAS Contract Address (auto-selected based on NETWORK)
# Base Sepolia: 0xC2679fBD37d54388Ce493F1DB75320D236e1815e
# Base Mainnet: 0x4200000000000000000000000000000000000021
# EAS_CONTRACT_ADDRESS=0x...

# Chain ID (optional - helps with network detection if RPC auto-detection fails)
# Base Sepolia: 84532
# Base Mainnet: 8453
# Ethereum Sepolia: 11155111
# Ethereum Mainnet: 1
# CHAIN_ID=11155111

# IPFS Configuration (for storing attestations)
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_KEY=your_pinata_secret
# IPFS_GATEWAY=https://gateway.pinata.cloud
